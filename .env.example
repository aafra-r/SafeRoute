# SafeRoute Environment Variables
FLASK_ENV=development
SECRET_KEY=saferoute-demo-secret-key-change-in-production-2026
JWT_SECRET_KEY=saferoute-jwt-secret-key-change-in-production-2026
DATABASE_URL=sqlite:///saferoute.db
PORT=5000

# Safety & Resilience Engine Configuration
RESILIENCE_THRESHOLD_SECONDS=120
DEVIATION_THRESHOLD_METERS=50
DEMO_MODE=true

# Optional External API Keys (SafeRoute falls back gracefully if not configured)
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MAPBOX_ACCESS_TOKEN=
